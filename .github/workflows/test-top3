name: Test notif top 3 (Discord)

on:
  workflow_dispatch:   # bouton "Run workflow" manuel uniquement

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Installer les dÃ©pendances
        run: |
          pip install -r requirements.txt
          python -m playwright install --with-deps chromium

      - name: Lancer le test
        env:
          PSEUDO: ${{ secrets.PSEUDO }}
          TOPIC: ${{ secrets.TOPIC }}
          DISCORD_WEBHOOK: ${{ secrets.DISCORD_WEBHOOK }}
        run: python test_top3.py

      - name: Garder la capture de test
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: test-screenshot
          path: top3_change.png
          if-no-files-found: ignore
